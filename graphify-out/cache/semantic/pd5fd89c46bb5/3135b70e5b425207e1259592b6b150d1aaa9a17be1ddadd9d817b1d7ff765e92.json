{"nodes": [{"id": "docs_superpowers_specs_2026_10_15_open_fresh_design_spec", "label": "Open-Fresh Design Specification", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-15-open-fresh-design.md", "source_location": "L1-L68", "source_url": null, "captured_at": "2026-10-15", "author": null, "contributor": null, "rationale": "Inverts Grocy's rigid workflow by providing live-correlated views over a shared kitchen state without locking users into a sequential wizard."}, {"id": "docs_superpowers_specs_2026_10_15_open_fresh_design_layered_pricing", "label": "Three-Tier Layered Pricing Model", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-15-open-fresh-design.md", "source_location": "L103-L133", "source_url": null, "captured_at": "2026-10-15", "author": null, "contributor": null, "rationale": "Open Prices has thin US store coverage, so pricing resolves per kitchen in order: (1) own price library, (2) Open Prices nearest match, (3) category estimate."}, {"id": "docs_superpowers_specs_2026_10_15_open_fresh_design_laya_decision_model", "label": "Laya System-1 Decision Model (ONNX Runtime)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-15-open-fresh-design.md", "source_location": "L77-L87", "source_url": "https://github.com/receptron/laya", "captured_at": "2026-10-15", "author": null, "contributor": null, "rationale": "Runs in-process on CPU via ONNX Runtime to make calibrated choice/score/noul judgment calls for meal planning without requiring a GPU."}, {"id": "docs_superpowers_specs_2026_10_15_open_fresh_design_recipe_ingest_pipeline", "label": "Local Recipe & Receipt Ingest Pipeline (Gemma 3n E2B/E4B)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-15-open-fresh-design.md", "source_location": "L72-L92", "source_url": null, "captured_at": "2026-10-15", "author": null, "contributor": null, "rationale": "Runs outside the app container behind an OpenAI-compatible endpoint using 